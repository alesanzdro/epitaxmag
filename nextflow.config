/*
 * ══════════════════════════════════════════════════════════════════
 *  nextflow.config — EpiTaxMAG Pipeline
 * ══════════════════════════════════════════════════════════════════
 *
 *  USAGE:
 *    nextflow run main.nf --input data/260225_EPIM230 -profile gru
 *    nextflow run main.nf --input data/260225_EPIM230 -profile gru,singularity
 *    nextflow run main.nf --input data/260225_EPIM230 -profile gru -resume
 *
 *  PROFILES:
 *    gru         → 48 threads, 200 GB RAM (Gru server)
 *    pc          → 20 threads, 56 GB RAM (desktop)
 *    censalud    → 24 threads, 58 GB RAM (CenSalud i7-14700)
 *    singularity → Singularity containers (combinable with gru/pc/censalud)
 *    conda       → Conda/Mamba environments (default if singularity is not used)
 */


// ── Default parameters ──────────────────────────────────────────────

params {
    help               = false
    singularity_bind   = null     // Singularity bind paths. Set in conf/local.config
    epitaxmag_tools_sif = null    // Path to epitaxmag-tools-X.X.X.sif. Set in conf/local.config
    input              = null
    outdir             = null
    run_name           = null

    // Phase control
    run_tax            = true       // Run TAX phase (taxonomic profiling)
    run_assembly       = false      // Run MAG phase (assembly + MAGs)

    // Optional host decontamination
    // Path to the host reference genome (.fasta/.fa/.fna).
    // If null, the host-removal step is skipped automatically.
    // Example: --host_genome /path/to/GRCh38.fna  (human)
    host_genome        = null

    // Read filtering
    min_quality        = 10
    min_length         = 1000
    kraken2_confidence = 0.1

    // Database root.
    // Set in conf/local.config or pass --db_root /path on the command line.
    // First run: the pipeline auto-downloads everything via workflow/setup_db.nf
    // unless --skip_db_setup is given.
    db_root            = "${projectDir}/databases"  // Override in conf/local.config

    // TAX databases
    kraken2_db         = "${params.db_root}/k2_pluspf_20251015"
    kaiju_nodes        = "${params.db_root}/kaiju/nodes.dmp"
    kaiju_names        = "${params.db_root}/kaiju/names.dmp"
    kaiju_fmi          = "${params.db_root}/kaiju/kaiju_db_refseq_ref.fmi"
    sylph_db           = "${params.db_root}/sylph/gtdb-r226-c200-dbv1.syldb"
    sylph_db_fungi     = "${params.db_root}/sylph/fungi-refseq-2025-10-11-c200-dbv1.syldb"
    sylph_db_viral     = "${params.db_root}/sylph/imgvr_c200_v0.3.0.syldb"
    fastqscreen_conf   = "${params.db_root}/fastqscreen/fastq_screen.conf"
    // FastQ Screen genome panel (tar.gz on Zenodo). If unset, setup_db.nf
    // creates an empty config the user must populate manually.
    fastqscreen_genomes_url = "https://zenodo.org/records/19860716/files/epitaxmag-fqs-panel-v1.tar.gz?download=1"
    resfinder_fsa      = "${params.db_root}/kma_resfinder/resfinder_db/all.fsa"

    // MAG databases
    checkm2_db         = "${params.db_root}/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
    gtdbtk_data        = "${params.db_root}/gtdbtk_r232/release232"
    // Bakta's installer extracts the database into `<root>/bakta/db/db/`; the
    // inner `db/` is the one that holds `version.json`, `bakta.db`, etc.
    bakta_db           = "${params.db_root}/bakta/db/db"
    genomad_db         = "${params.db_root}/genomad/genomad_db"
    // amrfinder_update writes a versioned sub-directory (`<date>.X`) plus
    // a `latest` symlink that points to it. AMRFinderPlus needs the path
    // to that inner versioned directory (where the formatted BLAST/HMM
    // indices live), so we resolve via the symlink one level deeper.
    amrfinder_db       = "${params.db_root}/amrfinderplus/latest/latest"
    // Skani: pre-built GTDB r226 sketch (v0.3 single-file DB, ~38 GB)
    skani_db           = "${params.db_root}/skani/skani_gtdb_r226-v0.3"

    // Custom scripts
    scripts_dir        = "${projectDir}/scripts"

    // Early-warning target organisms (Sylph screening).
    // Comma-separated list, matched against the genus in the Sylph Contig_name.
    // Edit to fit the surveillance panel of your project.
    target_organisms   = "Escherichia,Salmonella,Shigella,Vibrio,Campylobacter,Aeromonas,Arcobacter,Aliarcobacter,Pseudomonas,Legionella,Acinetobacter,Mycobacterium,Klebsiella,Enterococcus,Leptospira,Burkholderia,Phocaeicola,Bacteroides,Dorea,Naegleria,Cryptosporidium,Giardia"

    // Heavy thread count (overridden per profile)
    threads_heavy      = 20

    // Final report — MAG viability heuristics
    genome_size_mb     = 4.5      // Average bacterial genome size (Mb)
    min_coverage_mag   = 30       // Minimum theoretical coverage for assembly

    // MAG quality thresholds (MIMAG)
    mag_completeness_min   = 50   // Minimum completeness for medium-quality MAG
    mag_contamination_max  = 10   // Maximum contamination

    // Assembly
    flye_mode          = "--nano-hq"   // --nano-hq for SUP/duplex, --nano-raw for fast
    bakta_db_type      = "full"        // "full" (84 GB, complete annotation) or "light" (4 GB, basic)
    medaka_model       = "r1041_e82_400bps_sup_v5.2.0"  // R10.4.1 SUP v5.2.0 (bundled in Medaka 2.2.1)

    // Pre-filtered reads (reuse to run MAG without TAX)
    filtered_dir       = null          // Override: --filtered_dir /path/to/filtered/

    // Existing assemblies (reuse to skip MetaFlye)
    assemblies_dir     = null          // Override: --assemblies_dir /path/to/15_assembly_flye/

    // MAG taxonomic-classification tool selector.
    //   'skani'    — default. ANI-based, ~16 GB RAM, ~36 GB DB (GTDB r226, v0.3).
    //   'sourmash' — ultra-light fallback, ~5 GB RAM, ~3.7 GB DB (k-mer sketches).
    //   'gtdbtk'   — gold-standard reference. Requires ≥120 GB RAM and ~60 GB DB.
    taxonomy_tool      = 'skani'

    // DEPRECATED: legacy alias kept for backwards compatibility.
    // When set to true and taxonomy_tool was left at its default ('skani'),
    // main.nf rewrites it to 'sourmash'. Remove from CLI invocations and
    // pass `--taxonomy_tool sourmash` (or 'gtdbtk') instead.
    skip_gtdbtk        = false

    // Skip automatic DB download (use only when DBs are already in place)
    skip_db_setup      = false         // Override: --skip_db_setup

    // Persistent cache locations. Override per-machine in conf/local.config
    // when /home is on a small filesystem and conda envs would not fit.
    conda_cache_dir    = null          // null → falls back to ~/.cache/epitaxmag/conda

    // Phenotypic verification (optional).
    // TSV with columns 'organism' and 'accession' (NCBI RefSeq).
    // When set, type-strain genomes are downloaded and reads are mapped
    // against them to verify presence/absence. Disable with --phenotypic_targets false.
    phenotypic_targets = "${projectDir}/assets/phenotypic_targets/target_organisms.tsv"
}


// ── Nextflow execution reports ──────────────────────────────────────

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/timeline.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/pipeline_dag.html"
}


// ── Caches and work directory ───────────────────────────────────────
// Two distinct concerns:
//   1. Conda environments and Singularity images are *expensive to
//      build and reusable across every run* — they live in a stable
//      cache directory shared by all runs.
//   2. Per-task working files (intermediate outputs, .command.* logs,
//      task hashes) are *run-scoped* — they live next to the run's
//      outdir so the whole run is self-contained and can be archived
//      or removed atomically without affecting other runs.

// Persistent conda cache (override with NXF_CONDA_CACHEDIR or
// conf/local.config:params.conda_cache_dir if the home filesystem is small).
def _conda_cache = (
    System.getenv('NXF_CONDA_CACHEDIR')
    ?: (params.conda_cache_dir ?: "${System.getenv('HOME')}/.cache/epitaxmag/conda")
)
conda {
    enabled    = true
    useMamba   = true
    cacheDir   = _conda_cache
}

// Per-run work directory. When --outdir is set we drop work/ inside
// the outdir so each run owns its own intermediates; otherwise we
// fall back to the legacy `<projectDir>/work`.
// Override at the command line with `-w /custom/path` when needed.
workDir = params.outdir ? "${params.outdir}/work" : "${projectDir}/work"


// ── System environment ──────────────────────────────────────────────
// Make sure the TMPDIR directory exists before any process exports the
// env var (Nextflow exports the variable but does not create the path,
// and tools like amrfinder_update / bakta fail when it is missing).
def _tmpdir = (params.outdir ? "${params.outdir}/work/tmp"
                              : "${projectDir}/work/tmp")
new File(_tmpdir).mkdirs()

env {
    PYTHONNOUSERSITE   = '1'                       // Stop ~/.local/lib from leaking into conda envs
    TMPDIR             = _tmpdir                   // Avoid filling /tmp on the root partition
    // HTTP proxy: configure in conf/local.config if your network requires it
}


// ── First load of conf/local.config: pick up params overrides (db_root,
// proxy, etc.) BEFORE any params/process derivations resolve.
try { includeConfig 'conf/local.config' } catch (Exception e) { }


// ── Global process configuration ────────────────────────────────────

process {
    // Portable conda init: uses whichever `conda` is on PATH (miniconda3,
    // miniforge3, conda_py313, …). Override per-machine in conf/local.config
    // if your shell needs a fixed init script.
    beforeScript  = 'eval "$(conda shell.bash hook)"'
    errorStrategy = 'retry'
    maxRetries    = 1
    conda         = "${projectDir}/envs/nf-metatax.yml"

    // Python reporting processes always use conda — no biocontainer ships
    // pandas + plotly + openpyxl + reportlab together.
    withName: 'FINAL_REPORT' {
        conda = "${projectDir}/envs/nf-html-report.yml"
    }
    withName: 'KMA_READS' {
        conda = "${projectDir}/envs/nf-kma.yml"
    }

    // ── MAG phase: per-tool conda envs (avoid dependency conflicts)
    withName: 'METAFLYE' {
        conda = "${projectDir}/envs/nf-mag-flye.yml"
    }
    withName: 'MEDAKA' {
        conda = "${projectDir}/envs/nf-mag-medaka.yml"
    }
    withName: 'QUAST' {
        conda = "${projectDir}/envs/nf-mag-quast.yml"
    }
    withName: 'MAP_READS' {
        conda = "${projectDir}/envs/nf-metatax.yml"    // ships minimap2 + samtools
    }
    withName: 'METABAT2' {
        conda = "${projectDir}/envs/nf-mag-metabat2.yml"
    }
    withName: 'MAXBIN2' {
        conda = "${projectDir}/envs/nf-mag-maxbin2.yml"
    }
    withName: 'SEMIBIN2' {
        conda = "${projectDir}/envs/nf-mag-semibin.yml"
    }
    withName: 'DAS_TOOL' {
        conda = "${projectDir}/envs/nf-mag-dastool.yml"
    }
    withName: 'CHECKM2' {
        conda = "${projectDir}/envs/nf-mag-checkm2.yml"
    }
    withName: 'GTDBTK' {
        conda = "${projectDir}/envs/nf-mag-gtdbtk.yml"
    }
    withName: 'AMRFINDERPLUS_MAGS|AMR_ON_PLASMIDS' {
        conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml"
    }
    withName: 'GENOMAD' {
        conda = "${projectDir}/envs/nf-mag-genomad.yml"
    }
    // AMR / virulence / plasmid / annotation
    withName: 'ABRICATE' {
        conda = "${projectDir}/envs/nf-mag-abricate.yml"
    }
    withName: 'MOBSUITE' {
        conda = "${projectDir}/envs/nf-mag-mobsuite.yml"
    }
    withName: 'INTEGRONFINDER' {
        conda = "${projectDir}/envs/nf-mag-integronfinder.yml"
    }
    withName: 'BAKTA' {
        conda = "${projectDir}/envs/nf-mag-bakta.yml"
    }
    withName: 'SOURMASH_CLASSIFY' {
        conda = "${projectDir}/envs/nf-mag-sourmash.yml"
    }
    withName: 'SKANI_CLASSIFY' {
        conda = "${projectDir}/envs/nf-mag-skani.yml"
    }
    withName: 'AMR_PATHOGEN_INTEGRATION|MAG_REPORT' {
        conda = "${projectDir}/envs/nf-html-report.yml"
    }
}


// ── Profiles ────────────────────────────────────────────────────────
//
// Three size profiles cover the realistic deployment range:
//
//   low      ≥16 CPUs, ≥32 GB RAM  (modest workstation; El Salvador-class)
//   medium   ≥24 CPUs, ≥64 GB RAM  (recommended default; CenSalud-class)
//   high     ≥64 CPUs, ≥128 GB RAM (server; required for --taxonomy_tool gtdbtk)
//
// Each size lives in its own conf/<size>.config file (per-process
// resource tuning + maxForks). Legacy names (`pc`, `censalud`, `gru`)
// are kept as deprecated aliases — they include the same conf file as
// their size-named counterpart, and main.nf logs a deprecation warning
// when one of them is selected.

profiles {

    low      { includeConfig 'conf/low.config' }
    medium   { includeConfig 'conf/medium.config' }
    high     { includeConfig 'conf/high.config' }

    // ── Deprecated size aliases ────────────────────────────────────
    pc       { includeConfig 'conf/low.config' }
    censalud { includeConfig 'conf/medium.config' }
    gru      { includeConfig 'conf/high.config' }

    // ── Singularity overlay (combinable: -profile medium,singularity) ──
    // Replaces the conda directive on bio tools with Galaxy biocontainers.
    // Python reporting processes still fall back to conda — no biocontainer
    // ships pandas + plotly + reportlab + openpyxl together. The custom
    // `epitax-tools` SIF is configured via params.epitaxmag_tools_sif in
    // conf/local.config.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = params.singularity_bind ?: ''
        singularity.pullTimeout = '40m'
        // Persistent across runs (same logic as conda.cacheDir)
        singularity.cacheDir   = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: System.getenv('HOME') + '/.cache/epitaxmag/singularity'}"

        process {
            // ── TAX phase ──────────────────────────────────────────────
            withName: 'NANOPLOT_RAW|NANOPLOT_FILTERED' {
                container = 'https://depot.galaxyproject.org/singularity/nanoplot%3A1.46.2--pyhdfd78af_1'
            }
            withName: 'FASTQC_RAW|FASTQC_FILTERED' {
                container = 'https://depot.galaxyproject.org/singularity/fastqc%3A0.12.1--hdfd78af_0'
            }
            withName: 'MULTIQC' {
                container = 'https://depot.galaxyproject.org/singularity/multiqc%3A1.33--pyhdfd78af_0'
            }
            withName: 'PORECHOP' {
                container = 'https://depot.galaxyproject.org/singularity/porechop_abi%3A0.5.1--py39h475c85d_0'
            }
            withName: 'CHOPPER' {
                container = 'https://depot.galaxyproject.org/singularity/chopper%3A0.12.0b--hdcadc20_0'
            }
            withName: 'KRAKEN2' {
                container = 'https://depot.galaxyproject.org/singularity/kraken2%3A2.17.1--pl5321h077b44d_0'
            }
            withName: 'BRACKEN' {
                container = 'https://depot.galaxyproject.org/singularity/bracken%3A3.1--h9948957_0'
            }
            withName: 'KAIJU' {
                container = 'https://depot.galaxyproject.org/singularity/kaiju%3A1.10.1--h5ca1c30_3'
            }
            withName: 'SYLPH' {
                container = 'https://depot.galaxyproject.org/singularity/sylph%3A0.9.0--ha6fb395_0'
            }

            // Multi-tool processes use the custom epitax-tools image.
            withName: 'FASTQSCREEN|HOST_REMOVAL|KMA_READS|BUILD_PHENOTYPIC_DB|MINIMAP2_PHENOTYPIC' {
                container = params.epitaxmag_tools_sif
            }
            withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED|FINAL_REPORT' {
                container = params.epitaxmag_tools_sif
            }

            // ── MAG phase ──────────────────────────────────────────────
            withName: 'METAFLYE' {
                container = 'https://depot.galaxyproject.org/singularity/flye%3A2.9.6--py313h7fbb527_1'
            }
            withName: 'MEDAKA' {
                container = 'https://depot.galaxyproject.org/singularity/medaka%3A2.2.1--py312hc7af5e1_0'
            }
            withName: 'QUAST' {
                container = 'https://depot.galaxyproject.org/singularity/quast%3A5.3.0--py313pl5321h5ca1c30_2'
            }
            withName: 'MAP_READS' {
                container = params.epitaxmag_tools_sif   // minimap2 + samtools
            }
            withName: 'METABAT2' {
                container = 'https://depot.galaxyproject.org/singularity/metabat2%3A2.18--h38e344b_2'
            }
            withName: 'MAXBIN2' {
                container = 'https://depot.galaxyproject.org/singularity/maxbin2%3A2.2.7--h503566f_8'
            }
            withName: 'SEMIBIN2' {
                container = 'https://depot.galaxyproject.org/singularity/semibin%3A2.2.1--pyhdfd78af_0'
            }
            withName: 'DAS_TOOL' {
                container = 'https://depot.galaxyproject.org/singularity/das_tool%3A1.1.7--r44hdfd78af_1'
            }
            withName: 'CHECKM2' {
                container = 'https://depot.galaxyproject.org/singularity/checkm2%3A1.1.0--pyh7e72e81_1'
            }
            withName: 'GTDBTK' {
                container = 'https://depot.galaxyproject.org/singularity/gtdbtk%3A2.7.0--pyhdfd78af_0'
            }
            withName: 'AMRFINDERPLUS_MAGS' {
                container = 'https://depot.galaxyproject.org/singularity/ncbi-amrfinderplus%3A4.2.7--hf69ffd2_0'
            }
            withName: 'GENOMAD' {
                container = 'https://depot.galaxyproject.org/singularity/genomad%3A1.12.0--pyhdfd78af_0'
            }
            withName: 'ABRICATE' {
                container = 'https://depot.galaxyproject.org/singularity/abricate%3A1.4.0--h05cac1d_0'
            }
            withName: 'MOBSUITE' {
                container = 'https://depot.galaxyproject.org/singularity/mob_suite%3A3.1.9--pyhdfd78af_1'
            }
            withName: 'INTEGRONFINDER' {
                container = 'https://depot.galaxyproject.org/singularity/integron_finder%3A2.0rc6--py_0'
            }
            withName: 'BAKTA' {
                container = 'https://depot.galaxyproject.org/singularity/bakta%3A1.12.0--pyhdfd78af_0'
            }
            withName: 'SOURMASH_CLASSIFY' {
                container = 'https://depot.galaxyproject.org/singularity/sourmash%3A4.9.4--hdfd78af_0'
            }
            withName: 'SKANI_CLASSIFY' {
                container = 'https://depot.galaxyproject.org/singularity/skani%3A0.3.1--ha6fb395_0'
            }
            withName: 'AMR_PATHOGEN_INTEGRATION|MAG_REPORT' {
                container = params.epitaxmag_tools_sif
            }
        }
    }
}


// ── Final load of conf/local.config: ensure user overrides win for
// process.beforeScript, profiles, env, etc.
try { includeConfig 'conf/local.config' } catch (Exception e) { }
