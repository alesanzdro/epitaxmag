/*
 * ══════════════════════════════════════════════════════════════════
 *  nextflow.config — EpiTaxMAG Pipeline
 * ══════════════════════════════════════════════════════════════════
 *
 *  USO:
 *    nextflow run main.nf --input data/260225_EPIM230 -profile gru
 *    nextflow run main.nf --input data/260225_EPIM230 -profile gru,singularity
 *    nextflow run main.nf --input data/260225_EPIM230 -profile gru -resume
 *
 *  PROFILES:
 *    gru         → 48 threads, 200 GB RAM (servidor Gru)
 *    pc          → 20 threads, 56 GB RAM (equipo de mesa)
 *    singularity → Contenedores Singularity (combinable con gru/pc)
 *    conda       → Entornos Conda/Mamba (por defecto si no se usa singularity)
 */


// ── Parámetros por defecto ──────────────────────────────────────────

params {
    help               = false
    singularity_bind   = null     // Bind paths para Singularity. Definir en conf/local.config
    epitaxmag_tools_sif   = null     // Ruta a epitaxmag-tools-X.X.X.sif. Definir en conf/local.config
    input              = null
    outdir             = null
    run_name           = null

    // Control de fases
    run_tax            = true       // Ejecutar fase TAX (perfilado taxonómico)
    run_assembly       = false      // Ejecutar fase MAG (ensamblaje + MAGs)

    // Descontaminación de host (opcional)
    // Ruta al genoma de referencia del hospedador (.fasta/.fa/.fna)
    // Si es null, el paso se salta automáticamente
    // Ejemplo: --host_genome /path/to/GRCh38.fna  (humano)
    host_genome        = null

    // Filtrado
    min_quality        = 10
    min_length         = 1000
    kraken2_confidence = 0.1

    // Bases de datos
    // Ruta raíz: se define en conf/local.config o con --db_root /ruta
    // Primera ejecución: correr 'bash bin/setup_databases.sh --db-root /ruta'
    db_root            = "${projectDir}/databases"  // Override en conf/local.config

    // Fase TAX
    kraken2_db         = "${params.db_root}/k2_pluspf_20251015"
    kaiju_nodes        = "${params.db_root}/kaiju/nodes.dmp"
    kaiju_names        = "${params.db_root}/kaiju/names.dmp"
    kaiju_fmi          = "${params.db_root}/kaiju/kaiju_db_refseq_ref.fmi"
    sylph_db           = "${params.db_root}/sylph/gtdb-r226-c200-dbv1.syldb"
    sylph_db_fungi     = "${params.db_root}/sylph/fungi-refseq-2024-07-25-c200-v0.3.syldb"
    sylph_db_viral     = "${params.db_root}/sylph/imgvr_c200_v0.3.0.syldb"
    fastqscreen_conf   = "${params.db_root}/fastqscreen/fastq_screen.conf"
    // URL del panel de genomas FastQ Screen (tar.gz en Zenodo)
    // Si no se define, el setup genera un config vacio que el usuario debe rellenar
    fastqscreen_genomes_url = "https://zenodo.org/records/19860716/files/epitaxmag-fqs-panel-v1.tar.gz?download=1"
    resfinder_fsa      = "${params.db_root}/kma_resfinder/resfinder_db/all.fsa"

    // Fase MAG
    checkm2_db         = "${params.db_root}/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
    gtdbtk_data        = "${params.db_root}/gtdbtk_r232/release232"
    bakta_db           = "${params.db_root}/bakta/db"
    genomad_db         = "${params.db_root}/genomad/genomad_db"
    checkv_db          = "${params.db_root}/checkv/checkv-db-v1.5"
    amrfinder_db       = "${params.db_root}/amrfinderplus/latest"
    eggnog_db          = "${params.db_root}/eggnog"
    gunc_db            = "${params.db_root}/gunc/gunc_db_progenomes2.1.dmnd"
    busco_db           = "${params.db_root}/busco"

    // Scripts custom
    scripts_dir        = "${projectDir}/scripts"

    // Organismos de interes para alerta temprana (screening Sylph)
    // Formato: lista separada por comas. Se busca por genero en Contig_name de Sylph.
    // Modificar segun el panel de vigilancia del proyecto.
    target_organisms   = "Escherichia,Salmonella,Shigella,Vibrio,Campylobacter,Aeromonas,Arcobacter,Aliarcobacter,Pseudomonas,Legionella,Acinetobacter,Mycobacterium,Klebsiella,Enterococcus,Leptospira,Burkholderia,Phocaeicola,Bacteroides,Dorea,Naegleria,Cryptosporidium,Giardia"

    // Threads pesados (se sobreescribe por profile)
    threads_heavy      = 20

    // Reporte final — viabilidad MAGs
    genome_size_mb     = 4.5      // Tamaño genoma bacteriano promedio (Mb)
    min_coverage_mag   = 30       // Cobertura mínima teórica para ensamblaje

    // MAG quality (MIMAG standards)
    mag_completeness_min   = 50   // Mínimo completeness para MAG medium-quality
    mag_contamination_max  = 10   // Máximo contamination

    // Ensamblaje
    flye_mode          = "--nano-hq"   // --nano-hq para SUP/duplex, --nano-raw para fast
    bakta_db_type      = "full"        // "full" (84 GB, anotacion completa) o "light" (4 GB, basica)
    medaka_model       = "r1041_e82_400bps_sup_v5.2.0"  // R10.4.1 SUP v5.2.0 (empaquetado en container Medaka 2.2.1)

    // Reads filtrados (para correr MAG sin TAX)
    filtered_dir       = null          // Override: --filtered_dir /path/to/filtered/

    // Ensamblajes existentes (para saltar MetaFlye)
    assemblies_dir     = null          // Override: --assemblies_dir /path/to/15_assembly_flye/

    // Saltar GTDB-Tk si no hay suficiente RAM (>50 GB necesarios)
    skip_gtdbtk        = false         // Override: --skip_gtdbtk true

    // Saltar descarga automatica de DBs (si ya estan descargadas)
    skip_db_setup      = false         // Override: --skip_db_setup true

    // Verificación fenotípica (opcional)
    // TSV con columnas 'organism' y 'accession' (NCBI RefSeq).
    // Si se define, descarga type-strains y mapea reads para verificar presencia.
    // Para personalizar: editar el TSV y añadir/quitar organismos + accesiones.
    phenotypic_targets = "${projectDir}/assets/phenotypic_targets/target_organisms.tsv"
    // Para desactivar: --phenotypic_targets false
    // Para personalizar: editar el TSV o apuntar a otro fichero
}


// ── Reportes automáticos de Nextflow ────────────────────────────────

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/timeline.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/00_reports/pipeline_dag.html"
}


// ── Conda (por defecto) ─────────────────────────────────────────────

conda {
    enabled    = true
    useMamba   = true
    cacheDir   = "${projectDir}/work/conda"
}


// ── Entorno del sistema ─────────────────────────────────────────────

env {
    PYTHONNOUSERSITE   = '1'        // Evita que ~/.local/lib interfiera con conda
    TMPDIR             = "${projectDir}/work/tmp"  // Evitar /tmp lleno en particion root
    // Proxy: configurar en conf/local.config si tu red lo necesita
}


// ── Configuración local (específica de cada servidor) ───────────────
// Carga conf/local.config si existe. Contiene: db_root, proxy,
// singularity bind paths, fastqscreen_conf, etc.
// CADA USUARIO debe crear/editar su conf/local.config.

// Cargar conf/local.config si existe (opcional, especifico de cada servidor)
try { includeConfig 'conf/local.config' } catch (Exception e) { }


// ── Proceso global ──────────────────────────────────────────────────

process {
    beforeScript  = 'source /home/asanzc/conda_py313/etc/profile.d/conda.sh'
    errorStrategy = 'retry'
    maxRetries    = 1
    conda         = "${projectDir}/envs/nf-metatax.yml"

    // Los procesos de reporting Python usan conda siempre
    // (no hay containers biocontainers adecuados para plotly/reportlab)
    withName: 'FINAL_REPORT' {
        conda = "${projectDir}/envs/nf-html-report.yml"
    }
    withName: 'KMA_READS' {
        conda = "${projectDir}/envs/nf-kma.yml"
    }

    // ── Fase MAG: conda por herramienta (evita conflictos)
    withName: 'METAFLYE' {
        conda = "${projectDir}/envs/nf-mag-flye.yml"
    }
    withName: 'MEDAKA' {
        conda = "${projectDir}/envs/nf-mag-medaka.yml"
    }
    withName: 'QUAST' {
        conda = "${projectDir}/envs/nf-mag-quast.yml"
    }
    withName: 'MAP_READS' {
        conda = "${projectDir}/envs/nf-metatax.yml"    // tiene minimap2 + samtools
    }
    withName: 'METABAT2' {
        conda = "${projectDir}/envs/nf-mag-metabat2.yml"
    }
    withName: 'MAXBIN2' {
        conda = "${projectDir}/envs/nf-mag-maxbin2.yml"
    }
    withName: 'SEMIBIN2' {
        conda = "${projectDir}/envs/nf-mag-semibin.yml"
    }
    withName: 'DAS_TOOL' {
        conda = "${projectDir}/envs/nf-mag-dastool.yml"
    }
    withName: 'CHECKM2' {
        conda = "${projectDir}/envs/nf-mag-checkm2.yml"
    }
    withName: 'GTDBTK' {
        conda = "${projectDir}/envs/nf-mag-gtdbtk.yml"
    }
    withName: 'AMRFINDERPLUS_MAGS' {
        conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml"
    }
    withName: 'GENOMAD' {
        conda = "${projectDir}/envs/nf-mag-genomad.yml"
    }
    // Fase A processes
    withName: 'ABRICATE' {
        conda = "${projectDir}/envs/nf-mag-abricate.yml"
    }
    withName: 'MOBSUITE' {
        conda = "${projectDir}/envs/nf-mag-mobsuite.yml"
    }
    withName: 'INTEGRONFINDER' {
        conda = "${projectDir}/envs/nf-mag-integronfinder.yml"
    }
    withName: 'BAKTA' {
        conda = "${projectDir}/envs/nf-mag-bakta.yml"
    }
    withName: 'SOURMASH_CLASSIFY' {
        conda = "${projectDir}/envs/nf-mag-sourmash.yml"
    }
    withName: 'AMR_PATHOGEN_INTEGRATION|MAG_REPORT' {
        conda = "${projectDir}/envs/nf-html-report.yml"
    }
}


// ── Profiles ────────────────────────────────────────────────────────

profiles {

    // ┌──────────────────────────────────────────────────────────────┐
    // │  GRU — 48 threads, 200 GB RAM (servidor)                     │
    // │  Kraken2 DB completa en RAM, máximo paralelismo              │
    // └──────────────────────────────────────────────────────────────┘
    gru {
        params.threads_heavy = 48

        process {
            cpus   = 6
            memory = '8 GB'

            withName: 'KRAKEN2' {
                cpus     = 48
                memory   = '120 GB'      // DB PlusPF completa en RAM
                maxForks = 1
            }
            withName: 'KAIJU' {
                cpus     = 48
                memory   = '20 GB'
                maxForks = 1
            }
            withName: 'SYLPH' {
                cpus     = 48
                memory   = '16 GB'
            }
            withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED' {
                cpus     = 24
                memory   = '8 GB'
            }
            withName: 'HOST_REMOVAL' {
                cpus     = 48
                memory   = '16 GB'
            }
            withName: 'KMA_READS' {
                cpus     = 24
                memory   = '4 GB'
                conda    = "${projectDir}/envs/nf-kma.yml"
            }
            withName: 'BUILD_PHENOTYPIC_DB' {
                cpus     = 2
                memory   = '4 GB'
            }
            withName: 'MINIMAP2_PHENOTYPIC' {
                cpus     = 16
                memory   = '16 GB'
            }

            // Fase MAG — threads optimizados por herramienta
            // MetaFlye: escala muy bien, darle todo, 1 muestra a la vez
            withName: 'METAFLYE' {
                cpus     = 48
                memory   = '80 GB'
                maxForks = 1
            }
            // Medaka: inferencia neural monothread en CPU. Dar minimo cpus, max paralelismo
            withName: 'MEDAKA' {
                cpus     = 2
                memory   = '8 GB'
            }
            // QUAST: rapido, no necesita muchos threads
            withName: 'QUAST' {
                cpus     = 8
                memory   = '16 GB'
            }
            // minimap2: escala bien
            withName: 'MAP_READS' {
                cpus     = 16
                memory   = '16 GB'
            }
            // MetaBAT2: binning rapido
            withName: 'METABAT2' {
                cpus     = 8
                memory   = '16 GB'
            }
            withName: 'MAXBIN2' {
                cpus     = 8
                memory   = '16 GB'
            }
            // SemiBin2: deep learning, moderado
            withName: 'SEMIBIN2' {
                cpus     = 16
                memory   = '32 GB'
            }
            // DAS Tool: refinamiento, rapido
            withName: 'DAS_TOOL' {
                cpus     = 8
                memory   = '16 GB'
            }
            // CheckM2: moderado
            withName: 'CHECKM2' {
                cpus     = 16
                memory   = '32 GB'
            }
            // GTDB-Tk: pplacer puede necesitar >100 GB con r232
            withName: 'GTDBTK' {
                cpus     = 16
                memory   = '200 GB'
                maxForks = 1
            }
            // AMRFinderPlus: rapido
            withName: 'AMRFINDERPLUS_MAGS' {
                cpus     = 8
                memory   = '8 GB'
            }
            // geNomad: moderado
            withName: 'GENOMAD' {
                cpus     = 16
                memory   = '16 GB'
            }
            // Fase A
            withName: 'ABRICATE' { cpus = 8; memory = '4 GB' }
            withName: 'MOBSUITE' { cpus = 16; memory = '8 GB' }
            withName: 'INTEGRONFINDER' { cpus = 8; memory = '4 GB' }
            withName: 'BAKTA' { cpus = 16; memory = '8 GB' }
            withName: 'SOURMASH_CLASSIFY' { cpus = 8; memory = '8 GB' }
        }

        executor {
            name   = 'local'
            cpus   = 48
            memory = '240 GB'
        }
    }

    // ┌──────────────────────────────────────────────────────────────┐
    // │  PC — 20 threads, 56 GB RAM (equipo de mesa)                 │
    // │  Kraken2 con --memory-mapping para no saturar RAM            │
    // └──────────────────────────────────────────────────────────────┘
    pc {
        params.threads_heavy = 20

        process {
            cpus   = 4
            memory = '4 GB'

            withName: 'KRAKEN2' {
                cpus     = 20
                memory   = '48 GB'       // memory-mapping, no carga toda la DB
                maxForks = 1
            }
            withName: 'KAIJU' {
                cpus     = 20
                memory   = '18 GB'
                maxForks = 1
            }
            withName: 'SYLPH' {
                cpus     = 20
                memory   = '12 GB'
            }
            withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED' {
                cpus     = 10
                memory   = '6 GB'
            }
            withName: 'HOST_REMOVAL' {
                cpus     = 20
                memory   = '12 GB'
            }
            withName: 'KMA_READS' {
                cpus     = 10
                memory   = '4 GB'
                conda    = "${projectDir}/envs/nf-kma.yml"
            }
            withName: 'BUILD_PHENOTYPIC_DB' { cpus = 2;  memory = '4 GB' }
            withName: 'MINIMAP2_PHENOTYPIC' { cpus = 10; memory = '8 GB' }
            // Fase MAG — threads optimizados
            withName: 'METAFLYE' {  cpus = 20; memory = '40 GB'; maxForks = 1 }
            withName: 'MEDAKA' {    cpus = 2;  memory = '6 GB' }
            withName: 'QUAST' {     cpus = 6;  memory = '8 GB' }
            withName: 'MAP_READS' { cpus = 10; memory = '8 GB' }
            withName: 'METABAT2' {  cpus = 6;  memory = '8 GB' }
            withName: 'MAXBIN2' {  cpus = 6;  memory = '8 GB' }
            withName: 'SEMIBIN2' {  cpus = 10; memory = '16 GB' }
            withName: 'DAS_TOOL' {  cpus = 6;  memory = '8 GB' }
            withName: 'CHECKM2' {   cpus = 10; memory = '16 GB' }
            withName: 'GTDBTK' {   cpus = 10; memory = '40 GB'; maxForks = 1 }
            withName: 'AMRFINDERPLUS_MAGS' { cpus = 4; memory = '4 GB' }
            withName: 'GENOMAD' {  cpus = 10; memory = '8 GB' }
            // Fase A
            withName: 'ABRICATE' { cpus = 4; memory = '4 GB' }
            withName: 'MOBSUITE' { cpus = 10; memory = '8 GB' }
            withName: 'INTEGRONFINDER' { cpus = 4; memory = '4 GB' }
            withName: 'BAKTA' { cpus = 10; memory = '8 GB' }
            withName: 'SOURMASH_CLASSIFY' { cpus = 4; memory = '6 GB' }
            // GTDB-Tk: 40 GB puede ser justo en PC con 52 GB total
            // Si falla por OOM, correr con --skip_gtdbtk
        }

        executor {
            name   = 'local'
            cpus   = 20
            memory = '52 GB'
        }
    }

    // ┌──────────────────────────────────────────────────────────────┐
    // │  CENSALUD — 24 threads, 60 GB RAM (CenSalud)                 │
    // │  Intel i7-14700 (20C/28T) · 64 GB DDR4 · 2 TB NVMe          │
    // │  Kraken2 con --memory-mapping (DB PlusPF ~100 GB > RAM)      │
    // │  NVMe rápido → memory-mapping más eficiente que en HDD       │
    // └──────────────────────────────────────────────────────────────┘
    censalud {
        params.threads_heavy = 24

        process {
            cpus   = 4
            memory = '6 GB'

            withName: 'KRAKEN2' {
                cpus     = 24
                memory   = '55 GB'       // memory-mapping sobre NVMe (rápido)
                maxForks = 1
            }
            withName: 'KAIJU' {
                cpus     = 24
                memory   = '20 GB'
                maxForks = 1
            }
            withName: 'SYLPH' {
                cpus     = 24
                memory   = '14 GB'
            }
            withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED' {
                cpus     = 12
                memory   = '8 GB'
            }
            withName: 'HOST_REMOVAL' {
                cpus     = 24
                memory   = '14 GB'
            }
            withName: 'KMA_READS' {
                cpus     = 12
                memory   = '4 GB'
                conda    = "${projectDir}/envs/nf-kma.yml"
            }
            withName: 'BUILD_PHENOTYPIC_DB' { cpus = 2;  memory = '4 GB' }
            withName: 'MINIMAP2_PHENOTYPIC' { cpus = 12; memory = '12 GB' }
            // Fase MAG — threads optimizados
            withName: 'METAFLYE' {  cpus = 24; memory = '48 GB'; maxForks = 1 }
            withName: 'MEDAKA' {    cpus = 2;  memory = '6 GB' }
            withName: 'QUAST' {     cpus = 6;  memory = '8 GB' }
            withName: 'MAP_READS' { cpus = 12; memory = '12 GB' }
            withName: 'METABAT2' {  cpus = 6;  memory = '12 GB' }
            withName: 'MAXBIN2' {  cpus = 6;  memory = '12 GB' }
            withName: 'SEMIBIN2' {  cpus = 12; memory = '20 GB' }
            withName: 'DAS_TOOL' {  cpus = 6;  memory = '12 GB' }
            withName: 'CHECKM2' {   cpus = 12; memory = '20 GB' }
            withName: 'GTDBTK' {   cpus = 12; memory = '50 GB'; maxForks = 1 }
            withName: 'AMRFINDERPLUS_MAGS' { cpus = 6; memory = '4 GB' }
            withName: 'GENOMAD' {  cpus = 12; memory = '12 GB' }
            // Fase A
            withName: 'ABRICATE' { cpus = 6; memory = '4 GB' }
            withName: 'MOBSUITE' { cpus = 12; memory = '8 GB' }
            withName: 'INTEGRONFINDER' { cpus = 6; memory = '4 GB' }
            withName: 'BAKTA' { cpus = 12; memory = '8 GB' }
            withName: 'SOURMASH_CLASSIFY' { cpus = 6; memory = '6 GB' }
        }

        executor {
            name   = 'local'
            cpus   = 24
            memory = '58 GB'
        }
    }

    // ┌──────────────────────────────────────────────────────────────┐
    // │  SINGULARITY — Contenedores (combinable con gru/pc)          │
    // │  Uso: -profile gru,singularity                               │
    // │  Desactiva conda para herramientas bio y usa containers.     │
    // │  Los procesos de reporting Python siguen usando conda         │
    // │  (no hay biocontainers adecuados para plotly+reportlab).     │
    // └──────────────────────────────────────────────────────────────┘
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = params.singularity_bind ?: ''
        singularity.pullTimeout = '40m'
        singularity.cacheDir   = "${NXF_SINGULARITY_CACHEDIR ?: projectDir + '/work/singularity'}"

        process {

            // ── Fase TAX: Containers ────────────────────────────────
            withName: 'NANOPLOT_RAW|NANOPLOT_FILTERED' {
                container = 'https://depot.galaxyproject.org/singularity/nanoplot%3A1.46.2--pyhdfd78af_1'
            }
            withName: 'FASTQC_RAW|FASTQC_FILTERED' {
                container = 'https://depot.galaxyproject.org/singularity/fastqc%3A0.12.1--hdfd78af_0'
            }
            withName: 'MULTIQC' {
                container = 'https://depot.galaxyproject.org/singularity/multiqc%3A1.33--pyhdfd78af_0'
            }
            // ── Imagen custom: epitax-tools ──────────────────────────
            // Cubre procesos multi-herramienta que no tienen
            // biocontainer adecuado (fastq_screen+minimap2, Python
            // reports, host removal, KMA).
            // Build: bash containers/build.sh singularity
            // Ruta: definir params.epitaxmag_tools_sif en conf/local.config

            withName: 'FASTQSCREEN|HOST_REMOVAL|KMA_READS|BUILD_PHENOTYPIC_DB|MINIMAP2_PHENOTYPIC' {
                container = params.epitaxmag_tools_sif
            }
            withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED|FINAL_REPORT' {
                container = params.epitaxmag_tools_sif
            }

            // ── Biocontainers individuales ──────────────────────────
            withName: 'PORECHOP' {
                container = 'https://depot.galaxyproject.org/singularity/porechop_abi%3A0.5.1--py39h475c85d_0'
            }
            withName: 'CHOPPER' {
                container = 'https://depot.galaxyproject.org/singularity/chopper%3A0.12.0b--hdcadc20_0'
            }
            withName: 'KRAKEN2' {
                container = 'https://depot.galaxyproject.org/singularity/kraken2%3A2.17.1--pl5321h077b44d_0'
            }
            withName: 'BRACKEN' {
                container = 'https://depot.galaxyproject.org/singularity/bracken%3A3.1--h9948957_0'
            }
            withName: 'KAIJU' {
                container = 'https://depot.galaxyproject.org/singularity/kaiju%3A1.10.1--h5ca1c30_3'
            }
            withName: 'SYLPH' {
                container = 'https://depot.galaxyproject.org/singularity/sylph%3A0.9.0--ha6fb395_0'
            }

            // ── Fase MAG: Containers ──────────────────────────────
            withName: 'METAFLYE' {
                container = 'https://depot.galaxyproject.org/singularity/flye%3A2.9.6--py313h7fbb527_1'
            }
