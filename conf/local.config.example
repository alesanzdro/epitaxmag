/*
 * local.config.example — local configuration template
 *
 * Copy to conf/local.config and edit for your machine:
 *   cp conf/local.config.example conf/local.config
 *
 * This file holds paths and settings that depend on YOUR machine.
 * It is gitignored and must NOT be committed.
 */

// ── Database root ───────────────────────────────────────────────────
// Where all databases are downloaded and stored.
// The first pipeline run downloads them automatically (~360 GB total).
params.db_root = "${projectDir}/databases"

// ── FastQ Screen ────────────────────────────────────────────────────
// The config is generated automatically from the downloaded genomes.
// If you have a custom panel, point to it here:
// params.fastqscreen_conf = "/path/to/your/fastq_screen.conf"

// ── Custom Singularity image ────────────────────────────────────────
// Only needed when using -profile singularity
params.epitaxmag_tools_sif = "${projectDir}/containers/epitaxmag-tools-1.0.0.sif"

// ── Singularity bind paths ──────────────────────────────────────────
// Mount external disks that containers must see.
// autoMounts already binds $HOME automatically.
// params.singularity_bind = '--bind /disk1 --bind /disk2'

// ── Network proxy (optional) ────────────────────────────────────────
// Uncomment if your network requires a proxy:
// env.http_proxy  = 'http://proxy.example.com:8080'
// env.https_proxy = 'http://proxy.example.com:8080'

// ── Conda init script ───────────────────────────────────────────────
// Override the default `process.beforeScript` if your conda lives elsewhere.
// process.beforeScript = 'source /home/myuser/miniconda3/etc/profile.d/conda.sh'
