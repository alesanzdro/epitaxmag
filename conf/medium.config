/*
 * medium.config — default resource profile (CenSalud-class workstation)
 *
 * Target hardware: ≥24 CPU threads, ≥64 GB RAM, NVMe ≥2 TB.
 *
 * Default for the pipeline. GTDB-Tk is rejected (still too tight for
 * pplacer) — use --taxonomy_tool skani (default) or sourmash.
 */

params.threads_heavy = 24

process {
    cpus   = 4
    memory = '6 GB'

    // ── TAX phase ──────────────────────────────────────────────────────
    withName: 'NANOPLOT_RAW|NANOPLOT_FILTERED'           { cpus = 2; memory = '4 GB' }
    withName: 'FASTQC_RAW|FASTQC_FILTERED'               { cpus = 4; memory = '8 GB' }
    withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED'   { cpus = 4; memory = '8 GB' }
    withName: 'PORECHOP'                                 { cpus = 4; memory = '8 GB' }
    withName: 'CHOPPER'                                  { cpus = 4; memory = '4 GB' }
    withName: 'MULTIQC'                                  { cpus = 2; memory = '4 GB' }
    withName: 'FINAL_REPORT'                             { cpus = 2; memory = '4 GB';  conda = "${projectDir}/envs/nf-html-report.yml" }
    withName: 'BRACKEN'                                  { cpus = 2; memory = '4 GB' }

    // Mapping family
    withName: 'FASTQSCREEN'                              { cpus = 12; memory = '16 GB'; maxForks = 3 }
    withName: 'HOST_REMOVAL'                             { cpus = 12; memory = '16 GB'; maxForks = 3 }
    withName: 'MINIMAP2_PHENOTYPIC'                      { cpus = 12; memory = '16 GB'; maxForks = 3 }
    withName: 'KMA_READS'                                { cpus = 12; memory = '6 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-kma.yml" }
    withName: 'BUILD_PHENOTYPIC_DB'                      { cpus = 4;  memory = '6 GB' }

    // Heavy k-mer classifiers — Kraken2 stays in memory-mapping mode
    // (PlusPF DB ≈100 GB > 64 GB profile RAM).
    withName: 'KRAKEN2'                                  { cpus = 20; memory = '20 GB'; maxForks = 1 }
    withName: 'KAIJU'                                    { cpus = 20; memory = '20 GB'; maxForks = 1 }
    withName: 'SYLPH'                                    { cpus = 12; memory = '18 GB' }

    // ── MAG phase ──────────────────────────────────────────────────────
    withName: 'METAFLYE'         { cpus = 20; memory = '48 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-flye.yml" }
    withName: 'MEDAKA'           { cpus = 2;  memory = '6 GB';  maxForks = 8; conda = "${projectDir}/envs/nf-mag-medaka.yml" }
    withName: 'QUAST'            { cpus = 8;  memory = '12 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-quast.yml" }
    withName: 'MAP_READS'        { cpus = 12; memory = '16 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-metatax.yml" }

    // Binners
    withName: 'METABAT2'         { cpus = 8;  memory = '16 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-mag-metabat2.yml" }
    withName: 'MAXBIN2'          { cpus = 8;  memory = '16 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-mag-maxbin2.yml" }
    withName: 'SEMIBIN2'         { cpus = 12; memory = '20 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-mag-semibin.yml" }
    withName: 'DAS_TOOL'         { cpus = 8;  memory = '12 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-dastool.yml" }

    // MAG QC and taxonomy
    withName: 'CHECKM2'              { cpus = 12; memory = '20 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-mag-checkm2.yml" }
    withName: 'SKANI_CLASSIFY'       { cpus = 12; memory = '24 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-mag-skani.yml" }
    withName: 'SOURMASH_CLASSIFY'    { cpus = 6;  memory = '8 GB';  maxForks = 6; conda = "${projectDir}/envs/nf-mag-sourmash.yml" }
    withName: 'GTDBTK'               { cpus = 1;  memory = '1 GB';  maxForks = 1; conda = "${projectDir}/envs/nf-mag-gtdbtk.yml" }   // wired off in main.nf

    // AMR / virulence / plasmid / annotation
    withName: 'AMRFINDERPLUS_MAGS'   { cpus = 6;  memory = '6 GB';  maxForks = 6; conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml" }
    withName: 'AMR_ON_PLASMIDS'      { cpus = 6;  memory = '6 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml" }
    withName: 'GENOMAD'              { cpus = 8;  memory = '12 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-genomad.yml" }
    withName: 'ABRICATE'             { cpus = 6;  memory = '4 GB';  maxForks = 3; conda = "${projectDir}/envs/nf-mag-abricate.yml" }
    withName: 'MOBSUITE'             { cpus = 8;  memory = '12 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-mobsuite.yml" }
    withName: 'INTEGRONFINDER'       { cpus = 6;  memory = '8 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-integronfinder.yml" }
    withName: 'BAKTA'                { cpus = 6;  memory = '8 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-bakta.yml" }
    withName: 'AMR_PATHOGEN_INTEGRATION|MAG_REPORT' { cpus = 2; memory = '4 GB'; conda = "${projectDir}/envs/nf-html-report.yml" }
}

executor {
    name   = 'local'
    cpus   = 24
    memory = '64 GB'
}
