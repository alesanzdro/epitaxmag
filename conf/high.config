/*
 * high.config — server-class resource profile
 *
 * Target hardware: ≥64 CPU threads, ≥128 GB RAM, RAID/NVMe ≥4 TB.
 *
 * Only profile that allows --taxonomy_tool gtdbtk (pplacer needs ≥120 GB
 * for the GTDB r232 reference data). Skani remains the default.
 */

params.threads_heavy = 48

process {
    cpus   = 6
    memory = '8 GB'

    // ── TAX phase ──────────────────────────────────────────────────────
    withName: 'NANOPLOT_RAW|NANOPLOT_FILTERED'           { cpus = 2; memory = '4 GB' }
    withName: 'FASTQC_RAW|FASTQC_FILTERED'               { cpus = 4; memory = '8 GB' }
    withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED'   { cpus = 4; memory = '8 GB' }
    withName: 'PORECHOP'                                 { cpus = 4; memory = '8 GB' }
    withName: 'CHOPPER'                                  { cpus = 4; memory = '4 GB' }
    withName: 'MULTIQC'                                  { cpus = 2; memory = '4 GB' }
    withName: 'FINAL_REPORT'                             { cpus = 2; memory = '4 GB';  conda = "${projectDir}/envs/nf-html-report.yml" }
    withName: 'BRACKEN'                                  { cpus = 2; memory = '4 GB' }

    // Mapping family
    withName: 'FASTQSCREEN'                              { cpus = 16; memory = '24 GB'; maxForks = 4 }
    withName: 'HOST_REMOVAL'                             { cpus = 16; memory = '24 GB'; maxForks = 4 }
    withName: 'MINIMAP2_PHENOTYPIC'                      { cpus = 16; memory = '24 GB'; maxForks = 4 }
    withName: 'KMA_READS'                                { cpus = 16; memory = '8 GB';  maxForks = 6; conda = "${projectDir}/envs/nf-kma.yml" }
    withName: 'BUILD_PHENOTYPIC_DB'                      { cpus = 4;  memory = '8 GB' }

    // Heavy k-mer classifiers — Kraken2 PlusPF fits fully in RAM here.
    withName: 'KRAKEN2'                                  { cpus = 48; memory = '120 GB'; maxForks = 1 }
    withName: 'KAIJU'                                    { cpus = 48; memory = '24 GB';  maxForks = 1 }
    withName: 'SYLPH'                                    { cpus = 16; memory = '24 GB' }

    // ── MAG phase ──────────────────────────────────────────────────────
    withName: 'METAFLYE'         { cpus = 32; memory = '80 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-flye.yml" }
    withName: 'MEDAKA'           { cpus = 2;  memory = '8 GB';  maxForks = 12; conda = "${projectDir}/envs/nf-mag-medaka.yml" }
    withName: 'QUAST'            { cpus = 12; memory = '16 GB'; maxForks = 4; conda = "${projectDir}/envs/nf-mag-quast.yml" }
    withName: 'MAP_READS'        { cpus = 16; memory = '24 GB'; maxForks = 4; conda = "${projectDir}/envs/nf-metatax.yml" }

    // Binners
    withName: 'METABAT2'         { cpus = 12; memory = '24 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-metabat2.yml" }
    withName: 'MAXBIN2'          { cpus = 12; memory = '24 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-maxbin2.yml" }
    withName: 'SEMIBIN2'         { cpus = 16; memory = '32 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-semibin.yml" }
    withName: 'DAS_TOOL'         { cpus = 12; memory = '16 GB'; maxForks = 4; conda = "${projectDir}/envs/nf-mag-dastool.yml" }

    // MAG QC and taxonomy
    withName: 'CHECKM2'              { cpus = 16; memory = '32 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-checkm2.yml" }
    withName: 'SKANI_CLASSIFY'       { cpus = 16; memory = '32 GB'; maxForks = 3; conda = "${projectDir}/envs/nf-mag-skani.yml" }
    withName: 'SOURMASH_CLASSIFY'    { cpus = 8;  memory = '8 GB';  maxForks = 8; conda = "${projectDir}/envs/nf-mag-sourmash.yml" }
    // GTDB-Tk: only profile where pplacer fits; still serialized.
    withName: 'GTDBTK'               { cpus = 16; memory = '200 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-gtdbtk.yml" }

    // AMR / virulence / plasmid / annotation
    withName: 'AMRFINDERPLUS_MAGS'   { cpus = 8;  memory = '8 GB';  maxForks = 8; conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml" }
    withName: 'AMR_ON_PLASMIDS'      { cpus = 8;  memory = '8 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml" }
    withName: 'GENOMAD'              { cpus = 12; memory = '16 GB'; maxForks = 4; conda = "${projectDir}/envs/nf-mag-genomad.yml" }
    withName: 'ABRICATE'             { cpus = 8;  memory = '6 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-abricate.yml" }
    withName: 'MOBSUITE'             { cpus = 12; memory = '16 GB'; maxForks = 4; conda = "${projectDir}/envs/nf-mag-mobsuite.yml" }
    withName: 'INTEGRONFINDER'       { cpus = 8;  memory = '8 GB';  maxForks = 6; conda = "${projectDir}/envs/nf-mag-integronfinder.yml" }
    withName: 'BAKTA'                { cpus = 8;  memory = '8 GB';  maxForks = 6; conda = "${projectDir}/envs/nf-mag-bakta.yml" }
    withName: 'AMR_PATHOGEN_INTEGRATION|MAG_REPORT' { cpus = 2; memory = '4 GB'; conda = "${projectDir}/envs/nf-html-report.yml" }
}

executor {
    name   = 'local'
    cpus   = 64
    memory = '128 GB'
}
