/*
 * low.config — resource profile for modest workstations
 *
 * Target hardware: ≥16 CPU threads, ≥32 GB RAM, NVMe ≥1 TB.
 *
 * GTDB-Tk is rejected by the wiring in main.nf because pplacer needs
 * far more RAM than this profile can offer. Use --taxonomy_tool skani
 * (default) or --taxonomy_tool sourmash.
 */

params.threads_heavy = 16

process {
    cpus   = 2
    memory = '4 GB'

    // ── TAX phase ──────────────────────────────────────────────────────
    // Light Python / Java tools. maxForks left unbounded — Nextflow's
    // executor capacity already throttles the queue.
    withName: 'NANOPLOT_RAW|NANOPLOT_FILTERED'           { cpus = 2; memory = '4 GB' }
    withName: 'FASTQC_RAW|FASTQC_FILTERED'               { cpus = 4; memory = '6 GB' }
    withName: 'CHECK_SQCORE_RAW|CHECK_SQCORE_FILTERED'   { cpus = 4; memory = '6 GB' }
    withName: 'PORECHOP'                                 { cpus = 4; memory = '6 GB' }
    withName: 'CHOPPER'                                  { cpus = 4; memory = '4 GB' }
    withName: 'MULTIQC'                                  { cpus = 2; memory = '4 GB' }
    withName: 'FINAL_REPORT'                             { cpus = 2; memory = '4 GB';  conda = "${projectDir}/envs/nf-html-report.yml" }
    withName: 'BRACKEN'                                  { cpus = 2; memory = '4 GB' }

    // Mapping family — minimap2/KMA. Moderate RAM, scales with CPU.
    withName: 'FASTQSCREEN'                              { cpus = 8;  memory = '12 GB';  maxForks = 2 }
    withName: 'HOST_REMOVAL'                             { cpus = 8;  memory = '12 GB';  maxForks = 2 }
    withName: 'MINIMAP2_PHENOTYPIC'                      { cpus = 8;  memory = '12 GB';  maxForks = 2 }
    withName: 'KMA_READS'                                { cpus = 8;  memory = '6 GB';   maxForks = 2; conda = "${projectDir}/envs/nf-kma.yml" }
    withName: 'BUILD_PHENOTYPIC_DB'                      { cpus = 4;  memory = '6 GB' }

    // Heavy k-mer classifiers. Forced into memory-mapping for Kraken2 —
    // the script auto-detects from task.memory and adds --memory-mapping.
    withName: 'KRAKEN2'                                  { cpus = 12; memory = '12 GB';  maxForks = 1 }
    withName: 'KAIJU'                                    { cpus = 12; memory = '12 GB';  maxForks = 1 }
    withName: 'SYLPH'                                    { cpus = 8;  memory = '12 GB' }

    // ── MAG phase ──────────────────────────────────────────────────────
    withName: 'METAFLYE'         { cpus = 16; memory = '28 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-flye.yml" }
    withName: 'MEDAKA'           { cpus = 2;  memory = '6 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-medaka.yml" }
    withName: 'QUAST'            { cpus = 6;  memory = '8 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-quast.yml" }
    withName: 'MAP_READS'        { cpus = 8;  memory = '12 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-metatax.yml" }

    // Binners — MaxBin2 (bowtie2) and SemiBin2 (SPAdes) are the heaviest.
    withName: 'METABAT2'         { cpus = 6; memory = '12 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-metabat2.yml" }
    withName: 'MAXBIN2'          { cpus = 6; memory = '12 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-maxbin2.yml" }
    withName: 'SEMIBIN2'         { cpus = 8; memory = '16 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-semibin.yml" }
    withName: 'DAS_TOOL'         { cpus = 6; memory = '8 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-dastool.yml" }

    // MAG QC and taxonomy
    withName: 'CHECKM2'              { cpus = 8;  memory = '16 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-checkm2.yml" }
    withName: 'SKANI_CLASSIFY'       { cpus = 8;  memory = '16 GB'; maxForks = 1; conda = "${projectDir}/envs/nf-mag-skani.yml" }
    withName: 'SOURMASH_CLASSIFY'    { cpus = 4;  memory = '6 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-sourmash.yml" }
    withName: 'GTDBTK'               { cpus = 1;  memory = '1 GB';  maxForks = 1; conda = "${projectDir}/envs/nf-mag-gtdbtk.yml" }   // wired off in main.nf

    // AMR / virulence / plasmid / annotation
    withName: 'AMRFINDERPLUS_MAGS'   { cpus = 4;  memory = '6 GB';  maxForks = 4; conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml" }
    withName: 'AMR_ON_PLASMIDS'      { cpus = 4;  memory = '6 GB';  maxForks = 1; conda = "${projectDir}/envs/nf-mag-amrfinderplus.yml" }
    withName: 'GENOMAD'              { cpus = 6;  memory = '10 GB'; maxForks = 2; conda = "${projectDir}/envs/nf-mag-genomad.yml" }
    withName: 'ABRICATE'             { cpus = 4;  memory = '4 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-abricate.yml" }
    withName: 'MOBSUITE'             { cpus = 6;  memory = '8 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-mobsuite.yml" }
    withName: 'INTEGRONFINDER'       { cpus = 4;  memory = '6 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-integronfinder.yml" }
    withName: 'BAKTA'                { cpus = 4;  memory = '6 GB';  maxForks = 2; conda = "${projectDir}/envs/nf-mag-bakta.yml" }
    withName: 'AMR_PATHOGEN_INTEGRATION|MAG_REPORT' { cpus = 2; memory = '4 GB'; conda = "${projectDir}/envs/nf-html-report.yml" }
}

executor {
    name   = 'local'
    cpus   = 16
    memory = '32 GB'
}
